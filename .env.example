# ==========================================
# Shinx Environment Variables Template
# Copy this file to .env and fill in your values
# ==========================================

# --- LLM Configuration ---
# Supported providers: "google_genai" (default) or "openai"
SHINX_LLM_PROVIDER=google_genai

# Model name:
# - For Google: "gemini-3.5-flash-lite", "gemini-3.8-flash"
# - For OpenAI: "gpt-4o", "gpt-4o-mini"
SHINX_LLM_MODEL=gemini-3.5-flash-lite

# API Keys
GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_API_KEY=your_google_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# --- PostgreSQL Database Configuration ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=postgres
